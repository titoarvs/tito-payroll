# =============================================================================
# Required — the app will not boot without these
# =============================================================================

# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app

# Signs sessions and password-reset tokens. Generate with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me-with-a-generated-secret

# App origin. Reset links and OAuth callbacks are built from this.
# Dev: http://localhost:3000
# Prod: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that receive role "admin" on first sign-up.
# Without at least one entry there is no way into /users except a manual SQL update.
ADMIN_EMAILS=admin@example.com

# =============================================================================
# Optional — Google SSO
# The Google button is always shown on login/signup.
# Until these are set, clicking it explains how to configure OAuth.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):
#   http://localhost:3000/api/auth/callback/google
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Optional — transactional email (Resend)
# When RESEND_API_KEY is unset, reset URLs are printed to the server console.
# That is fine for local development; never ship production without Resend.
# =============================================================================

RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# Optional — S3-compatible file storage (avatars, product images)
# Required together for uploads: REGION, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY
# =============================================================================

S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://cdn.your-domain.com

# =============================================================================
# Optional — Stripe commerce
# =============================================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=usd

# =============================================================================
# Optional — Google Analytics 4
# =============================================================================

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
